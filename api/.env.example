# Copy to .env for local development. Never commit the real file.

# development | test | production
WORDNEST_ENVIRONMENT=development

# anthropic | fake
#   `fake` needs no API key and returns deterministic nonsense, which is enough
#   to run the whole app end to end. It is refused in production.
WORDNEST_TRANSLATION_PROVIDER=fake

# Required when the provider is `anthropic`. Keep it here and never on a device.
# WORDNEST_ANTHROPIC_API_KEY=sk-ant-...
WORDNEST_TRANSLATION_MODEL=claude-opus-5

WORDNEST_TRANSLATION_RATE_LIMIT_PER_MINUTE=60

# deepgram | fake
#   `fake` needs no API key and returns a description of the audio it was sent,
#   which is enough to run the speech relay end to end. Refused in production.
WORDNEST_SPEECH_PROVIDER=fake

# Required when the speech provider is `deepgram`. Keep it here and never on a
# device — routing audio through this service is the only reason it can be.
# WORDNEST_DEEPGRAM_API_KEY=...
WORDNEST_DEEPGRAM_MODEL=nova-3

# A hard ceiling on one speech session. Transcription is billed by the minute,
# so a client that stops sending without closing must not hold one open.
WORDNEST_SPEECH_SESSION_SECONDS=300
WORDNEST_SPEECH_RATE_LIMIT_PER_MINUTE=20

# Writes user sentences into the log. Development only, and only briefly.
WORDNEST_LOG_REQUEST_BODIES=false
WORDNEST_LOG_LEVEL=INFO

# Browser origins allowed to call the API. Empty is correct for a mobile-only
# client; never set this to "*".
# WORDNEST_CORS_ORIGINS=["http://localhost:3000"]
